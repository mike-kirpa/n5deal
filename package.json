{
  "name": "n5deal-qa",
  "version": "1.0.0",
  "private": true,
  "description": "QA assessment and Playwright test suite for N5Deal",
  "scripts": {
    "test": "playwright test --project=api --project=chromium",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:characterization": "playwright test --project=characterization",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:known-bugs": "playwright test --project=known-api --project=known-chromium",
    "test:all": "playwright test --project=api --project=chromium --project=known-api --project=known-chromium",
    "test:documented": "node scripts/with-readme.cjs",
    "test:headed": "playwright test --project=api --project=chromium --headed",
    "test:report": "node scripts/show-report.cjs",
    "test:expiration": "node scripts/run-expiration.cjs",
    "typecheck": "tsc --noEmit",
    "audit:artifacts": "node scripts/audit-artifacts.cjs",
    "ci:preflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ci/control.cjs preflight",
    "ci:discover": "node scripts/ci/control.cjs discover",
    "ci:report": "node scripts/ci/control.cjs summary"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "typescript": "5.9.3"
  }
}
